# Copy to .env and adjust. Never commit .env.
# Devices and their usernames and passwords live in the database (DATABASE_FILE). Manage them
# from the Devices page in the UI or the /api/inventory endpoints.

DISCOVERY_INTERVAL_SECONDS=60
DISCOVERY_MAX_CONCURRENCY=10
LINK_DOWN_RETENTION_RUNS=10
DATABASE_FILE=data/topology.db

# Key that encrypts device passwords in the database. Keep a copy: without it the stored
# passwords cannot be read. Create one with (local venv or Docker):
#   .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Optional: devices imported once, when the database has no devices yet.
DEVICES_FILE=devices.yaml

CORS_ORIGINS=["http://localhost:5173"]
